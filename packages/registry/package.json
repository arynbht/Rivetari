{
  "name": "@arynbht/rivetari-registry",
  "version": "1.0.0",
  "description": "Skill registry: pinned, hashed, scanned skills with manifests; sync, add, update and vendor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arynbht/Rivetari.git",
    "directory": "packages/registry"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifests"
  ],
  "scripts": {},
  "dependencies": {
    "@arynbht/rivetari-engine": "workspace:*",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
