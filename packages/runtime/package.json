  "description": "Task runtime: task cards and ledger, the router, and the judge (and, later, sector agents) for rivetari v2.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arynbht/Rivetari.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
